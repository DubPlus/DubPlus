{
  "name": "dubplus",
  "version": "4.1.2",
  "type": "module",
  "description": "Dub+ - A simple script/extension for QueUp.net",
  "main": "dubplus.js",
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=11.0.0"
  },
  "scripts": {
    "build": "vite build && cd extension && web-ext build --filename dubplus-extension.zip --overwrite-dest --artifacts-dir ../dist",
    "ci:build": "eslint src && vite build",
    "watch": "vite build --watch",
    "firefox": "cd extension && web-ext run --start-url www.queup.net --watch-files dist/dubplus.js dist/dubplus.css",
    "prepare": "husky install",
    "prettier": "prettier --write .",
    "purge-cache": "node ./tasks/purge-cache.js",
    "zip-source": "rm -rf extension/dist && rm -f dist/dubplus-source.zip && node ./tasks/zip.js",
    "addon-submit": "npm run zip-source && npm run ci:build && node --env-file .env ./tasks/ff-add-on-submit.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DubPlus/DubPlus.git"
  },
  "author": "DubPlus",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/DubPlus/DubPlus/issues"
  },
  "homepage": "https://dub.plus",
  "devDependencies": {
    "@babel/preset-env": "^7.28.6",
    "@rollup/plugin-terser": "^0.4.4",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@types/chrome": "^0.1.33",
    "@types/node": "^22.19.7",
    "eslint-plugin-svelte": "^3.14.0",
    "globals": "^17.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "prettier": "^3.8.0",
    "prettier-plugin-svelte": "^3.4.1",
    "svelte": "^5.53.6",
    "vite": "^7.3.1",
    "web-ext": "^9.2.0"
  },
  "browserslist": [
    "> 1%",
    "last 2 versions"
  ],
  "lint-staged": {
    "*.{js,svelte}": "eslint",
    "*.{js,svelte,css,ts,yml,yaml,md}": "prettier --list-different --write"
  }
}
